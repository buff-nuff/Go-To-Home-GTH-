      \uC788\uC5C8\uB2E4 \r\n"
  - name: "\uD478\uB4DC\uD2B8\uB7ED \uC0AC\uC7A5"
    sentence: "\uC5B4\uC774, \uD559\uC0DD! \uC624\uB298\uB3C4 \uB2A6\uAC8C \uAC00\uB124?"
  - name: "\uC774\uD604"
    sentence: "\u2026\u2026!"
  - name: "\uB098\uB798\uC774\uC158"
    sentence: "\uD604\uC758 \uC2DC\uC57C\uAC00 \uC0B4\uC9DD \uD754\uB4E4\uB9AC\uACE0\r\n\uD478\uB4DC\uD2B8\uB7ED\uC758
      \uBD88\uBE5B\uC774 \uBC18\uC9DD\uC774\uBA70, \uC0AC\uC7A5\uC758 \uC55E\uCE58\uB9C8\uAC00
      \uC774\uC0C1\uD558\uAC8C \uBE5B\uB098 \uBCF4\uC774\uAE34\uD55C\uB2E4"
  - name: "\uC774\uD604"
    sentence: "\uC800 \uD669\uB871\uD558\uACE0 \uACE0\uAE09\uC9C4 \uBE5B\u2026!?\uC124\uB9C8...?!"
  - name: "\uD478\uB4DC\uD2B8\uB7ED \uC0AC\uC7A5"
    sentence: "\uC544\uC800\uC528\uB791 [\uBE44\uBC00]\uB5A1\uBCF6\uC774 \uD55C\uBC88
      \uBA39\uC5B4\uBCF4\uB828?"
  - name: "\uC774\uD604\uC758 \uD658\uC0C1 \uC18D"
    sentence: "\uD6C4\uD6C4\u2026\u2026 \uB18D\uC758 \uAC00\uD638\uB97C \uBC1B\uC740
      \uB9C8\uBC95\uC18C\uB144\uC774\uC5EC....\r\n\uB098\uC758 \uB530\uB048\uB530\uB048\uD55C
      \uAD74\uBCF5\uD560\uC218\uBC16\uC5D0 \uC5C6\uB294(?)\uB97C \uBC1B\uC544\uBCF4\uB828?"
