  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 346310563}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74748658aa88eca4abca4455f360b67c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  nameText: {fileID: 304403530}
  storyText: {fileID: 1283982744}
  dialogues:
  - name: "\uB098\uB798\uC774\uC158"
    sentence: "\uAD50\uC2E4\uC5D0\uB294 \uC544\uC9C1 \uB530\uB73B\uD55C \uD574"
  - name: "\uC774\uC548"
    sentence: "\uC720\uAE30\uBB18... \uC785\uC591...?"
  - name: "\uC54C\uBC14\uC0DD"
    sentence: "\uB124! \uC544\uC774\uB4E4\uC5D0\uAC8C \uB530\uB73B\uD55C \uAC00\uC871\uC744
      \uCC3E\uC544\uC8FC\uB294 \uCEA0\uD398\uC778\uC774\uC5D0\uC694!"
  - name: "\uC774\uC548"
    sentence: "\uBB50\uB77C\uACE0...? \uACE0\uC591\uC774\uB4E4\uC744 \uC778\uAC04\uACC4
      \uACC4\uC57D\uC5D0 \uBB36\uC5B4\uB450\uACA0\uB2E4\uB294 \uAC74\uAC00!"
  - name: "\uC54C\uBC14\uC0DD"
    sentence: "\uB124? \uC544\uB2C8, \uADF8\uAC8C \uC544\uB2C8\uB77C\uC694..."
  - name: "\uC774\uC548"
    sentence: "\uC6A9\uC11C \uBABB \uD55C\uB2E4. \uB3D9\uBB3C\uC758 \uC790\uC720\uB294
      \uB0B4\uAC00 \uC9C0\uD0A8\uB2E4!"
  - name: "\uC54C\uBC14\uC0DD"
    sentence: "\uC800, \uC800\uAE30\uC694?! \uC65C \uAC11\uC790\uAE30 \uC804\uD22C
      \uC790\uC138\uB97C?!"
