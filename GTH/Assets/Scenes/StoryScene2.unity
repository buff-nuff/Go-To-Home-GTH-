--- !u!114 &1931974597
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1931974596}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 74748658aa88eca4abca4455f360b67c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryManager
  nameText: {fileID: 117790328}
  storyText: {fileID: 1209823886}
  dialogues:
  - name: "\uB098\uB798\uC774\uC158"
    sentence: "\uB9C8\uBC95\uC18C\uB140\uC758 \uC601\uAD11\uC2A4\uB7EC\uC6B4 \uC9C4\uD654\uB97C
      \uD1B5\uD574 \uAC00\uB358 \uC9C0\uB098\uAC00\uB358 \uB9C8\uBC95\uC18C\uB1401."
  - name: "\uB098\uB798\uC774\uC158"
    sentence: "\uAC00\uB358\uB3C4\uC911 \uB514\uC9C0\uD138(?)\uC804\uAD11\uD310\uC5D0
      \uBD99\uC5B4\uC788\uB294 \uC120\uAE00\uB77C\uADF8 \uAECC\uBB49\uCE58\uB97C
      \uBCF4\uAC8C\uB41C\uB2E4. \r\n"
  - name: "\uB8E8\uBBF8\uD2F0"
    sentence: "\uD558\uD558\uD558!!\uC55E\uC5D0 \uC660 \uD074\uB808 \uC9C0\uB2A5
      \uBE70\uCE58\uB294 \uB9C8\uBC95\uC18C\uB140\uAC00 \uC9C0\uB098\uAC00\uC796\uC544!!\u314B\u314B\u314B\u314B\u314B"
  - name: "\uC774\uC548"
    sentence: "300\uC6D0 \uC9DC\uB9AC \uC54C\uC0AC\uD0D5\uC774 \uBB50\uB77C\uB294\uACA8?
      \uB098\uB294 \uB9C8\uBC95\uC18C\uB140\uB530\uC704\uAC00 \uC544\uB2C8\uB77C
      /\uB9C8/\uBC95/\uC18C/\uB144/\uC774\uAC70\uB4E0!"
  - name: "\uB8E8\uBBF8\uD2F0"
    sentence: "\"\uD558\uD558\uD558!\uD0DC\uAD6D\uD589 \uD2F0\uCF13\uC744 \uC5B8\uC81C
      \uB04A\uC5C8\uC5C8\uB370?\u314B\u314B\u314B\u314B\u314B\u314B\""
  - name: "\uC774\uC548"
    sentence: "\uADF8\uB7F0 \uCC9C\uBC15\uD55C \uB9D0 \uC4F0\uB2E4\uB2C8....\uB108
      \uBC29\uAD6C\uC11D \uC5EC\uD3EC\uC9C0?"
  - name: "\uC2DC\uC2A4\uD15C"
    sentence: "\uD329\uD2B8\uD3ED\uB825 \uBC94\uC8C4\uC785\uB2C8\uB2E4.\uC911\uB300\uD55C
      \uBC94\uC8C4 \uC785\uB2C8\uB2E4.\r\n\uC544.\uC0C1\uB300\uB294 \uC0AC\uB78C\uC774
      \uC544\uB2D8\uC73C\uB85C \uBB34\uC8C4\uC785\uB2C8\uB2E4."
  - name: "\uB8E8\uBBF8\uD2F0"
    sentence: "\uD478\uD558\uD573\uD558\u314F\u3145!!!\u314B\u314B\u314B\u314B\uBE75\uAFB8\uB625\uAFB8\u314B\u314B\u314B\u314B\uADFC\uB098?\uD558\uD558\u314F\u314E"
  - name: "\uB8E8\uBBF8\uD2F0"
    sentence: "\uB108....\uC774\uC81C \uB108\uBB34 \uB178\uC7BC\uC774\uC57C!!\u314B\u314B\u314B\u314B\uADF8\uB7EC\uB2C8...\uB108\uB97C
      \uCC0C\uBD80\uB41C \uB538\uAE30\uB85C \uB9CC\uB4E4\uC5B4 \uBC8C\uB9AC\uB9AC\uAE4C\uB098~~\u314B\u314B\u314B\u314B"
  - name: "\uC774\uC548"
    sentence: "\uBB50\uB77C\uB294 \uAC70\uC5EC!\uBB50...\uC5B4\uCA0C\uB4E0 \uC601\uAD11\uC2A4\uB7EC\uC6B4
      \uD798\uC744 \uB9C8\uBC95\uC18C\uB140\uC758 \uD798\uC73C\uB85C \uC815\uC758\uB97C
      \uAD6C\uC6D0\uD574\uC8FC\uC9C0! "
  - name: "\uB8E8\uBBF8\uD2F0"
    sentence: "\uD558\uD558\uD558\u314F\u314F\u314F\u314F!!\uADF8\uB7EC\uC154\uC694~\uD558\uD558\uD558!\uC5EC\uAE30
      \uB3C8\uD0A4\uD63C\uD14C \uB0A9\uC2DC\uC624~~\u314B\u314B\u314B\u314B\u314B"
